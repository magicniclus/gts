rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function isImage() { return request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024; }

    match /site/{file=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage();
      allow delete: if isAdmin();
    }
    match /articles/{id}/{file=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage();
      allow delete: if isAdmin();
    }
    match /{all=**} { allow read, write: if false; }
  }
}
