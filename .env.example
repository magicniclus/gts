# URL publique du site (jamais de domaine en dur dans le code)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase (client) — en développement, les émulateurs suffisent
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-gts
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-gts.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-gts.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_USE_EMULATORS=true

# Serveur
FIREBASE_SERVICE_ACCOUNT=
# ou, plus simple en local : chemin du fichier JSON du compte de service
# GOOGLE_APPLICATION_CREDENTIALS=C:\\chemin\\vers\\gtsimmo-service-account.json
IP_HASH_SALT=change-me

# Analytics et anti-spam (facultatifs en développement)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
