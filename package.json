{
  "name": "gts-diagnostic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/emulators.mjs --ui --persist \"npm run seed -- --exemples --admin && next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --project components && npm run test:emu",
    "coverage": "node scripts/emulators.mjs \"vitest run --coverage\"",
    "e2e": "node scripts/emulators.mjs \"npm run seed -- --admin && next build && playwright test\"",
    "data:generate": "tsx scripts/generate-data.ts",
    "dev:next": "next dev",
    "emulators": "npm run functions:build && firebase emulators:start --project demo-gts --only auth,firestore,storage,functions --import=.emulator-data --export-on-exit",
    "seed": "tsx scripts/seed.ts",
    "test:unit": "vitest run --project unit --project components",
    "emu": "node scripts/emulators.mjs",
    "build:emu": "node scripts/emulators.mjs \"npm run seed && next build\"",
    "e2e:run": "playwright test",
    "test:emu": "node scripts/emulators.mjs \"vitest run --project emulator\"",
    "functions:build": "node scripts/predev.mjs && npm --prefix functions run build",
    "set-admin": "tsx scripts/set-admin.ts",
    "check-seo": "tsx scripts/check-seo.ts",
    "quality": "node scripts/emulators.mjs \"bash scripts/quality.sh\"",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "favicon:generate": "node scripts/generate-favicon.mjs",
    "dev:firebase": "next dev",
    "seed:firebase": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "set-admin:firebase": "node --env-file=.env.local --import tsx scripts/set-admin.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@lhci/cli": "^0.15.1",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "^15.32.1",
    "jsdom": "^29.1.1",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
